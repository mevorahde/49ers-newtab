{
  "manifest_version": 3,
  "name": "David's New Tab",
  "version": "1.0",
  "description": "Custom 49ers-themed New Tab page with SF Sports Night font.",
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "permissions": ["geolocation"],
  "host_permissions": [
    "https://api.open-meteo.com/*",
    "https://geocoding-api.open-meteo.com/*",
    "https://nominatim.openstreetmap.org/*",
    "https://ipapi.co/*",
    "https://raw.githubusercontent.com/*",
    "https://www.nfl.com/*"
  ],
  "icons": {
    "128": "icon.png"
  }
}
